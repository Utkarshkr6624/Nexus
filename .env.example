# =============================================================================
# NEXUS — environment configuration
# =============================================================================
# Copy this file to `.env` in the repository root and adjust the values.
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets.
#
# Under Docker Compose this file does double duty. Besides configuring a backend
# run directly on the host, it is passed verbatim to the `backend` and
# `frontend` containers, so this is the one place to configure the stack; the
# compose file overrides only the values that cannot survive into a container
# and lets everything else through unchanged.
#
# Those exceptions are worth knowing about:
#   POSTGRES_HOST=postgres   (not 127.0.0.1 — that is the container itself)
#   DATABASE_URL             (assembled from POSTGRES_* by the backend, because
#                             the URL below points at a host-local server)
#   NEXUS_HOST / NEXUS_RELOAD, and the VITE_* proxy settings
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Runtime environment: development | test | production
ENVIRONMENT=development
# Enable verbose FastAPI behaviour and SQLAlchemy query echo
DEBUG=true
APP_NAME=NEXUS
APP_VERSION=0.1.0
# One-line summary shown in the OpenAPI schema and at the top of the docs UI
APP_DESCRIPTION=NEXUS — Personal Intelligence & Decision Platform. A local-first system for projects, planning, knowledge, analytics and ML.
# OpenAPI / Swagger / ReDoc mount points
OPENAPI_URL=/openapi.json
DOCS_URL=/docs
REDOC_URL=/redoc
# Prefix every versioned route is mounted under. Changing it means the
# frontend's VITE_API_BASE_URL has to change with it.
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# MUST be replaced with a strong random value in any real deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-change-me
# JWT signing algorithm and lifetimes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Accounts, sessions and audit (Phase 2)
# -----------------------------------------------------------------------------
# Shortest password the API will store. The policy is this length plus an
# uppercase letter, a lowercase letter, a digit and one character that is
# neither a letter nor a digit. It is enforced by a single validator attached to
# the password schema itself, so register, change and reset all reject the same
# values. The browser mirrors the rules for its live checklist, but the server is
# the only authority.
PASSWORD_MIN_LENGTH=8
# Lifetime of a password-reset token. Short by design: the token is a bearer
# credential for a full account takeover, and the address is only demonstrably
# reachable while the requester still has the mailbox.
PASSWORD_RESET_EXPIRE_MINUTES=30
# Whether POST /auth/password/forgot may return the raw reset token in its
# response body. Leave false unless you need to complete the flow by hand:
# the endpoint answers identically for known and unknown addresses so it cannot
# be used to enumerate accounts, and returning the token for the known one
# removes that protection and hands an unauthenticated caller a full takeover
# for anyone whose address they can guess.
DEV_EXPOSE_RESET_TOKEN=false
# Hard ceiling on the age of a device session, independent of refresh rotation.
# Without it a session that is never signed out of could keep rotating its
# refresh token indefinitely and outlive any actual sign-in event.
SESSION_ABSOLUTE_LIFETIME_DAYS=30
# Concurrent live sessions allowed per account. Signing in beyond the cap
# revokes the oldest ones rather than refusing the sign-in, so a stolen refresh
# token cannot be replayed to accumulate access.
MAX_ACTIVE_SESSIONS=20
# How long audit rows are kept.
# NOT ENFORCED YET: there is no pruning job. This states the policy and gives the
# value somewhere to be displayed; nothing is currently deleting rows, so the
# table grows for as long as the install lives.
AUDIT_LOG_RETENTION_DAYS=400

# -----------------------------------------------------------------------------
# Rate limiting (in-process, fixed window)
# -----------------------------------------------------------------------------
# NEXUS throttles by client address and route, in process memory, with a fixed
# window. It exists because the two credential routes below are otherwise an open
# password-guessing oracle: bcrypt costs an attacker roughly a quarter of a
# second a try, which slows them down but never stops them.
# The counters live in memory, so the budget resets when the process restarts
# and is NOT shared between workers. Behind more than one worker, set the same
# numbers on every one of them; that is a per-worker budget, not a global one.
#
# Master switch. Turn it off only to isolate a throttled client, and understand
# that doing so removes the only thing standing between an internet-facing
# deployment and a password-guessing loop.
RATE_LIMIT_ENABLED=true
# Length of the fixed window every counter is measured over, in seconds. A
# minute is the unit an operator thinks in ("20 a minute") and is short enough
# that a burst is forgiven quickly.
RATE_LIMIT_WINDOW_SECONDS=60
# Requests one client address may make to ONE route inside a window, for
# everything except the credential routes below. Generous on purpose: this is a
# runaway-client backstop, not a quota.
RATE_LIMIT_GENERAL_MAX_REQUESTS=600
# Requests one address may make to /auth/login and /auth/password/forgot inside
# a window. Two attempts a second is below the ~4/s a single bcrypt
# verification already permits, so this does not extend a patient attacker's
# timeline; it stops a PARALLELISED guess flood and the address rotation an
# enumerator would otherwise use.
RATE_LIMIT_CREDENTIAL_MAX_REQUESTS=120
# Ceiling on tracked client/route pairs. The store is swept well before this,
# so it is a backstop against a client that can reach the limiter with unbounded
# distinct keys -- a hard guarantee the limiter cannot become the memory leak it
# exists to prevent.
RATE_LIMIT_MAX_ENTRIES=10000
# Whether to take the client address from X-Forwarded-For. OFF BY DEFAULT, AND
# DELIBERATELY: that header is attacker-controlled on any path that does not
# terminate in a proxy you control, so honouring it would let a caller mint a
# fresh bucket per request by rotating the header -- and every client would then
# share the proxy's address. Turn it on only when NEXUS really does sit behind a
# trusted reverse proxy.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# -----------------------------------------------------------------------------
# Backend server (read by backend/run.py)
# -----------------------------------------------------------------------------
# 0.0.0.0 inside Docker, 127.0.0.1 for local development.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# Hot reload for local development. Never enable in production.
NEXUS_RELOAD=true

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
# Use 127.0.0.1, not `localhost`. On Windows `localhost` resolves to ::1 first
# and psycopg's async driver only speaks IPv4, so the app would hang on start.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional explicit SQLAlchemy URL. When empty, the URL is assembled from the
# POSTGRES_* values above. Compose ignores it: inside a container the URL has to
# be assembled too, because the host is `postgres`, not 127.0.0.1.
# Leave the user and password percent-encoded (`quote(..., safe="")`) — a raw
# @ : / # ? % in a credential produces a DSN the driver cannot parse.
DATABASE_URL=postgresql+psycopg://nexus:nexus@127.0.0.1:5432/nexus
# Database used by the pytest suite. Created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://nexus:nexus@127.0.0.1:5432/nexus_test
# Connection pool tuning
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Wall-clock budget for the "SELECT 1" liveness probe. DB_POOL_TIMEOUT only
# bounds waiting for a free connection, not the handshake behind it, so a
# wedged server would otherwise stall until the OS TCP timeout.
DB_PROBE_TIMEOUT_SECONDS=3
# Wall-clock budget for the TCP/TLS handshake itself, on every connection the
# application opens. DB_POOL_TIMEOUT does not cover this: a new physical
# connection is opened outside the wait for a free pool slot, and psycopg's own
# default is 130 seconds. Without this bound, a database that is down made every
# request that touched it hang for over two minutes before failing.
DB_CONNECT_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Planner (Phase 4)
# -----------------------------------------------------------------------------
# IANA zone used to decide which DAY BOUNDARIES a planner view spans when a
# request does not pass `tz`. Every stored instant is UTC; this does not shift
# one. 08:00-20:00 is a daytime window, not a working-hours claim -- it is what
# the scheduler assumes when it has been told nothing about this user.
PLANNER_DEFAULT_TIMEZONE=UTC
PLANNER_DAY_START_HOUR=8
PLANNER_DAY_END_HOUR=20
# Shortest block the scheduler will propose. Below this a "session" is a
# rounding error that costs a context switch for no useful work.
PLANNER_MIN_SESSION_MINUTES=15
# Longest single block. Past this the scheduler splits the work instead of
# proposing one block nobody will sit through.
PLANNER_MAX_SESSION_MINUTES=240
# Cap per task, so one large task cannot fill the whole horizon ahead of a task
# that is due tomorrow.
PLANNER_MAX_SUGGESTIONS_PER_TASK=3
# How far forward the scheduler will search. Bounded so a request over a large
# backlog stays a bounded walk of availability rather than a scan.
PLANNER_LOOKAHEAD_DAYS=30

# -----------------------------------------------------------------------------
# Analytics (Phase 6)
# -----------------------------------------------------------------------------
# THE FOUR PRODUCTIVITY WEIGHTS MUST SUM TO 100, AND SETTINGS REFUSES TO BUILD
# IF THEY DO NOT. The productivity score is presented as a percentage, so these
# are its denominators: a set summing to 90 would report a "80/100" that is
# really "80/90", and one summing to 120 would report a score of 100 having
# awarded 120 points. `Settings` is constructed once at import time, so a set
# that does not add up REFUSES PROCESS START with a message naming the four
# values and the required total. There is no silent renormalisation: hiding
# that the configured numbers were wrong would make the scale unarguable.
# To retune the score, change one of these and give the difference to another.
ANALYTICS_PRODUCTIVITY_WEIGHT_COMPLETION=30
ANALYTICS_PRODUCTIVITY_WEIGHT_DEADLINE=25
ANALYTICS_PRODUCTIVITY_WEIGHT_CONSISTENCY=20
ANALYTICS_PRODUCTIVITY_WEIGHT_FOCUS=25
# Period lengths offered for period-over-period comparison. NOT READ BY THE
# CODE: the analytics endpoints derive each comparison period from the range
# the caller asked for. Kept so an existing .env carrying it still validates.
ANALYTICS_COMPARISON_WINDOWS=7,30,90
# Default window when a request names no dates. A week is the shortest span that
# can distinguish a habit from a one-off.
ANALYTICS_DEFAULT_RANGE_DAYS=7
# Hard ceiling on any requested range, in days. A range query with no bound is
# the one shape this system's indexes cannot serve: every aggregate scans the
# owner's whole history. 366 is a leap year, the longest legitimate span.
ANALYTICS_MAX_RANGE_DAYS=366
# Ceiling on POST /analytics/rebuild, which is the WRITE path: it recomputes
# each day from the underlying rows and upserts.
ANALYTICS_REBUILD_MAX_DAYS=180

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit machine-readable JSON logs (recommended for the backend container)
LOG_JSON=true
# Optional file destination, e.g. logs/backend.log. Empty = stdout only.
LOG_FILE=
# Log incoming request bodies. Keep false: request bodies may hold user data.
LOG_REQUEST_BODY=false
# Requests slower than this are logged at WARNING. Milliseconds.
SLOW_REQUEST_MS=1000

# -----------------------------------------------------------------------------
# Frontend (Vite — only VITE_* variables reach the browser bundle)
# -----------------------------------------------------------------------------
# Base URL of the backend API, including the version prefix. Keep it RELATIVE
# so the browser calls the same origin and the Vite dev server proxy forwards
# to the backend — that is what makes the dev server an accurate stand-in for
# the production reverse proxy. An absolute value here bypasses the proxy,
# turns every API call cross-origin (so CORS applies and cookies stop being
# sent), and only works for origins listed in CORS_ORIGINS below.
VITE_API_BASE_URL=/api/v1
# Server-side only — read by frontend/vite.config.ts and never bundled into the
# browser build. Where the dev server and `vite preview` forward /api and
# /health. Leave as-is when running the frontend directly on the host; compose
# overrides it to http://backend:8000, because inside the network `localhost`
# would be the frontend container itself.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Reserved: declared in frontend/src/vite-env.d.ts, read by no code in
# frontend/src yet. Kept — rather than deleted — so the names stay stable for
# whoever wires the features up. Changing them has no effect today.
# Intended use: the absolute backend origin, to link to the OpenAPI schema.
VITE_API_SERVER_URL=http://localhost:8000
# Intended use: the product name in the document title and the wordmark, both
# of which are hardcoded today.
VITE_APP_NAME=NEXUS
# Intended use: toggling the in-app command palette and its first-run shortcut
# hint, neither of which exists yet.
VITE_ENABLE_COMMAND_PALETTE=true

# -----------------------------------------------------------------------------
# Developer intelligence (Phase 8)
# -----------------------------------------------------------------------------
# NEXUS reads LOCAL git repositories through the `git` CLI, on the machine the
# backend runs on. There is no hosted account to connect. Every one of these is a
# deployment decision about how much a scan may cost or reach.
#
# Wall-clock budget for one `git` invocation. A repository that hangs -- a
# network-mounted work tree, a filter process waiting on a prompt -- must come
# back as an ERROR scan row carrying a human sentence, not as a request that
# never returns. The subprocess is killed when this elapses.
DEVELOPER_GIT_TIMEOUT_SECONDS=30
# Upper bound on the commits one scan will transfer. Scans read history
# incrementally, so this is a backstop against a repository whose entire log is
# new to us -- not the expected volume.
DEVELOPER_MAX_COMMITS_PER_SCAN=2000
# How many repositories one account may register. Each registered path is a
# directory the server will read on demand.
DEVELOPER_MAX_REPOSITORIES=100
# Window used when a request names no dates. A month, not a week: a week of
# commits cannot distinguish a habit from an off week.
DEVELOPER_DEFAULT_WINDOW_DAYS=30
# Hard ceiling on any requested window, in days. Every windowed aggregate scans
# the owner's whole commit history, so an unbounded range is the one query shape
# these indexes cannot serve.
DEVELOPER_MAX_WINDOW_DAYS=366
# Bucket size for the activity series when a request names none. One of `day`,
# `week` or `month`. Validated where it is read, not here: an unknown bucket size
# is a request the caller can be told about, whereas a process that refuses to
# start takes the whole app down over one analytics preference.
DEVELOPER_ACTIVITY_GRANULARITY_DEFAULT=day
# Comma-separated roots under which a repository may be registered.
# EMPTY MEANS ANY READABLE ABSOLUTE PATH that validates as a git work tree,
# which is the correct default for a local-first application bound to loopback.
# SECURITY CONTROL, NOT A PREFERENCE: in any shared deployment an empty
# allowlist lets any authenticated account ask the server to run `git` against
# any directory it can read. Set it there.
#   DEVELOPER_PATH_ALLOWLIST=E:/src,C:/Users/me/code
DEVELOPER_PATH_ALLOWLIST=

# -----------------------------------------------------------------------------
# Learning and career (Phase 9)
# -----------------------------------------------------------------------------
# Window used when a request names no dates. A month, for the same reason
# DEVELOPER_DEFAULT_WINDOW_DAYS is: a skill level is only ever described
# alongside how much was recorded inside the window.
LEARNING_DEFAULT_WINDOW_DAYS=30
# Hard ceiling on any requested window, in days.
LEARNING_MAX_WINDOW_DAYS=366
# How many learning goals one account may keep. ARCHIVED GOALS STILL COUNT --
# deleting them would delete the record the user kept them for.
LEARNING_MAX_GOALS=200
# How many skills one account may keep. The skills list is the input to every
# skill-gap calculation, so this cap is also what bounds that computation per
# request.
LEARNING_MAX_SKILLS=100
# Below this many activities for a skill, NEXUS offers NO level estimate at all
# and says so in the reason field. This is a REFUSAL, not a low-confidence
# badge: a thin sample shown with a "low confidence" label is still a claim,
# whereas a stated refusal is not.
# NOT A TUNING KNOB. Lowering it to 1 makes every tracked skill with a single
# recorded activity carry a number NEXUS derived, shown with the same weight as
# one derived from forty.
LEARNING_MIN_EVIDENCE_FOR_ESTIMATE=3
# Ceiling on rows in one career-evidence list. Everything on a profile is
# user-supplied or user-approved, so this is a rendering bound rather than a
# correctness one.
CAREER_MAX_EVIDENCE=500
# After this many days with no recorded activity, a target skill counts as
# dormant and is eligible for a "revive this skill" suggestion. Three weeks is
# roughly one review cycle: long enough that someone deep in a project does not
# get nagged, short enough that a habit has visibly lapsed.
CAREER_STALE_INACTIVE_DAYS=21

# -----------------------------------------------------------------------------
# ML integration (Phase 11)
# -----------------------------------------------------------------------------
# Master switch for the intent classifier. Off means NEXUS never loads the
# Phase 10 checkpoint; every other route keeps working, and the ML endpoints
# answer 503 with code "ml_unavailable" rather than inventing a result.
ML_ENABLED=true
# Where the trained checkpoint lives. Leave EMPTY to resolve the Phase 10
# default — <backend>/ml/artifacts/small-model/final — relative to the
# repository, so the project keeps working when it is moved to another machine.
# This is deployment configuration and is deliberately not settable per request:
# a caller able to choose it would be choosing which weights answer them.
ML_MODEL_PATH=
# "auto" uses CUDA when the machine has a working CUDA build and CPU otherwise.
# "cpu" and "cuda" pin the choice; asking for "cuda" on a machine without one
# is a startup failure rather than a silent downgrade, because an operator who
# asked for the GPU deserves to know they did not get it. NEXO never requires
# an NVIDIA GPU.
ML_DEVICE=auto
# Confidence a prediction must reach before NEXUS will name a service for it.
# 0.90 is an INTEGRATION threshold, not a calibrated probability: it was chosen
# by re-running the checkpoint over the 420-row held-out test split, where it
# keeps 95.2% of utterances while lifting precision on accepted requests from
# 0.9738 to 0.9900. It was measured on synthetic, template-generated text, so
# real user input will be less confident and less often right.
ML_CONFIDENCE_THRESHOLD=0.90
# Hard ceiling on submitted text, enforced before the model sees it. The model
# was trained at a 128-token context; this bound is a rendering and cost bound
# well above it, not a way to tune accuracy.
ML_MAX_INPUT_CHARS=2000
# Refuse credential-shaped text (a live API key, a private key block, a bearer
# token) before it is classified, using the detector Phase 10 wrote for exactly
# this shape of untrusted input. On by default: a user who has pasted a live
# secret into a chat box has already lost control of it, and classifying the
# request only makes the loss quieter. Set false if you routinely phrase account
# requests in a way the detector reads as a secret.
ML_REJECT_CREDENTIALS=true
# When false (the default) a checkpoint that will not load degrades to an
# explicit, reportable "unavailable" state and the rest of NEXUS still serves.
# When true the process refuses to start instead — for a deployment that would
# rather fail loudly than run with its headline feature quietly missing.
ML_FAIL_FAST=false

# -----------------------------------------------------------------------------
# Docker Compose (only used by the compose stack itself)
# -----------------------------------------------------------------------------
# Interface the published ports bind to: the database, the API and the Vite dev
# server. The default, 127.0.0.1, keeps all three reachable from this machine
# only. Widening it to 0.0.0.0 or a LAN address publishes them to every host on
# the network — in front of the default nexus/nexus credentials, a placeholder
# SECRET_KEY and DEBUG=true. Only do that on a network you trust as much as the
# machine itself.
BIND_HOST=127.0.0.1
POSTGRES_CONTAINER_NAME=nexus-postgres
POSTGRES_VOLUME_NAME=nexus_pgdata
BACKEND_CONTAINER_NAME=nexus-backend
FRONTEND_CONTAINER_NAME=nexus-frontend
