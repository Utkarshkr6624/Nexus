{"id": "phase6_reasoning-logic-001", "suite": "phase6_reasoning", "category": "phase6_reasoning/logic", "messages": [{"role": "user", "content": "All roses are flowers. Some flowers are red. Does it follow that some roses are red? Start your answer with yes, no or undetermined, then explain in one sentence."}], "tool_names": [], "check": [{"type": "regex", "pattern": "^\\W*(?:no|undetermined|not necessarily)\\b"}], "oracle": "No - the red flowers might not include any roses.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-contradiction-002", "suite": "phase6_reasoning", "category": "phase6_reasoning/contradiction", "messages": [{"role": "user", "content": "Statement A: 'The meeting is on Tuesday.' Statement B: 'The meeting is not on Tuesday.' Can both statements be true at the same time? Start with yes or no."}], "tool_names": [], "check": [{"type": "regex", "pattern": "^\\W*(?:no)\\b"}], "oracle": "No, they contradict each other.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-insufficient_evidence-003", "suite": "phase6_reasoning", "category": "phase6_reasoning/insufficient_evidence", "messages": [{"role": "user", "content": "A box holds 10 balls. I drew 3 of them and all 3 were red. Is it certain that all 10 balls are red? Start with yes or no."}], "tool_names": [], "check": [{"type": "regex", "pattern": "^\\W*(?:no)\\b"}], "oracle": "No - the 7 undrawn balls could be any colour.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-constraint-004", "suite": "phase6_reasoning", "category": "phase6_reasoning/constraint", "messages": [{"role": "user", "content": "Ana, Ben and Cy sit in a row of three seats. Ana is not in either end seat. Ben sits somewhere to the left of Ana. Who sits in the rightmost seat? Answer with the name only."}], "tool_names": [], "check": [{"type": "regex", "pattern": "^\\W*(?:cy)\\b"}], "oracle": "Cy", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-arithmetic-005", "suite": "phase6_reasoning", "category": "phase6_reasoning/arithmetic", "messages": [{"role": "user", "content": "I buy three products at ₹40 each and pay with a ₹200 note. How much change do I get?"}], "tool_names": [], "check": [{"type": "final_number", "value": 80}], "oracle": "Your change is ₹80.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-time-006", "suite": "phase6_reasoning", "category": "phase6_reasoning/time", "messages": [{"role": "user", "content": "A bus departs at 10:15 AM and the journey takes 2 hours 35 minutes. When does it arrive?"}], "tool_names": [], "check": [{"type": "contains_any", "phrases": ["12:50"]}], "oracle": "It arrives at 12:50 PM.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-scheduling-007", "suite": "phase6_reasoning", "category": "phase6_reasoning/scheduling", "messages": [{"role": "user", "content": "A task takes 45 minutes of work. I start at 11:30 and take one 15-minute break in the middle. At what time do I finish?"}], "tool_names": [], "check": [{"type": "contains_any", "phrases": ["12:30"]}], "oracle": "You finish at 12:30.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-planning-008", "suite": "phase6_reasoning", "category": "phase6_reasoning/planning", "messages": [{"role": "user", "content": "To bake bread: knead 10 minutes, let it rise 60 minutes, shape 5 minutes, bake 30 minutes. Preheating the oven takes 15 minutes and can happen while the dough rises. What is the minimum total time in minutes from starting to knead until baking finishes?"}], "tool_names": [], "check": [{"type": "final_number", "value": 105}], "oracle": "The minimum is 105 minutes.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-fraction-009", "suite": "phase6_reasoning", "category": "phase6_reasoning/fraction", "messages": [{"role": "user", "content": "What is 3/4 + 1/8? Give the answer as a fraction in lowest terms."}], "tool_names": [], "check": [{"type": "regex", "pattern": "\\b7\\s*/\\s*8\\b"}], "oracle": "3/4 + 1/8 = 7/8", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-percent-010", "suite": "phase6_reasoning", "category": "phase6_reasoning/percent", "messages": [{"role": "user", "content": "What is 15% of 80?"}], "tool_names": [], "check": [{"type": "final_number", "value": 12}], "oracle": "15% of 80 is 12.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-multi_step-011", "suite": "phase6_reasoning", "category": "phase6_reasoning/multi_step", "messages": [{"role": "user", "content": "A ₹200 item is discounted by 25%, then 10% tax is added to the discounted price. What is the final price in rupees?"}], "tool_names": [], "check": [{"type": "final_number", "value": 165}], "oracle": "The final price is ₹165.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-units-012", "suite": "phase6_reasoning", "category": "phase6_reasoning/units", "messages": [{"role": "user", "content": "Convert 2.5 kilometres to metres."}], "tool_names": [], "check": [{"type": "final_number", "value": 2500}], "oracle": "2.5 km is 2500 metres.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-negatives-013", "suite": "phase6_reasoning", "category": "phase6_reasoning/negatives", "messages": [{"role": "user", "content": "Compute -7 + 12 - (-3)."}], "tool_names": [], "check": [{"type": "final_number", "value": 8}], "oracle": "-7 + 12 - (-3) = 8", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-edge_case-014", "suite": "phase6_reasoning", "category": "phase6_reasoning/edge_case", "messages": [{"role": "user", "content": "What is the average of -4, 0 and 4?"}], "tool_names": [], "check": [{"type": "final_number", "value": 0}], "oracle": "The average is 0.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-word_problem-015", "suite": "phase6_reasoning", "category": "phase6_reasoning/word_problem", "messages": [{"role": "user", "content": "A train travels at 60 km/h for 2.5 hours. How far does it go in kilometres?"}], "tool_names": [], "check": [{"type": "final_number", "value": 150}], "oracle": "It travels 150 km.", "source": "handwritten", "suite_version": "phase6-v1"}
{"id": "phase6_reasoning-modulo-016", "suite": "phase6_reasoning", "category": "phase6_reasoning/modulo", "messages": [{"role": "user", "content": "What is the remainder when 47 is divided by 5?"}], "tool_names": [], "check": [{"type": "final_number", "value": 2}], "oracle": "The remainder is 2.", "source": "handwritten", "suite_version": "phase6-v1"}
