frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/.turbo/
frontend/*.tsbuildinfo

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local database dumps — but the container init scripts are source, not dumps.
*.sql
!docker/**/*.sql
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/

# ---------------------------------------------------------------------------
# Local model / ML artefacts (added in later phases)
# ---------------------------------------------------------------------------
mlruns/
artifacts/
# Phase 10 pipeline state. The generators in backend/ml/datasets/ are source
# and must stay tracked — ignoring that directory wholesale would untrack
# routing.py, schema.py, taxonomy.py and the rest of the package, which is the
# same trap `/models/` is anchored below to avoid. What is ignored here is the
# ML virtualenv and everything the pipeline *emits*: the JSONL datasets, the
# capability inventory, the run manifests, checkpoints and reports.
backend/ml/.venv/
backend/ml/datasets/*.jsonl
backend/ml/datasets/*.jsonl.*
backend/ml/datasets/*.json
backend/ml/artifacts/
backend/ml/reports/
# Notebooks are rendered artifacts, not source. `backend/ml/artifacts/` already
# covers the ones Phase 10 writes today; this catches a notebook rendered
# somewhere else before someone commits a multi-megabyte generated JSON blob.
*.ipynb
# Anchored to the repository root on purpose. Unanchored, `models/` matched
# `backend/app/models/` as well, so every ORM model was silently untracked and a
# clone would have been missing its entire schema.
/models/
*.onnx
*.pkl
*.joblib

# NEXO (Qwen3-8B) weights and runtime binaries stay on disk only: several exceed GitHub's
# 100 MB file limit and Git for Windows truncates files over 4 GiB. Jarvis/MODEL_ARTIFACTS.md
# lists each one with its source and SHA-256 so a clone can restore and verify them.
*.gguf
*.safetensors
*.pt
*.pth
/Jarvis/**/*.zip
/Jarvis/jarvis_phase7/runtime/llama.cpp/
/Jarvis/jarvis_phase7/runtime/downloads/
/Jarvis/jarvis_phase7/runtime/src/
/qwen_jarvis_phase3_4/v3_build/external/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs & scratch
# ---------------------------------------------------------------------------
logs/
*.log
.tmpchk/

# Generated review artefacts. `.uxsweep/` holds UX sweep output (personas,
# captured OpenAPI snapshots) and `report.txt` is a run report — both are
# regenerated by the tool that writes them, so neither is source.
.uxsweep/
report.txt
