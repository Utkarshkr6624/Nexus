{
 "protocol_version": "toolproto-1",
 "status": "ILLUSTRATIVE. None of these tools exists in the current NEXUS application (Phase 1 audit: no tool registry, no generic file/terminal/web/http/db tools). They define the conceptual protocol that a FUTURE NEXUS tool layer would implement.",
 "naming": {
  "rule": "canonical_name = dotted_name with '.' replaced by '_' ; canonical names match ^[a-z][a-z0-9_]{0,63}$ and are what appears in `tools`, `tool_calls` and `tool` messages. Dotted names exist only in the Phase 2 source text.",
  "pattern": "^[a-z][a-z0-9_]{0,63}$"
 },
 "result_envelope": {
  "description": "Every `tool` message content is a compact JSON string (separators (',',':'), ensure_ascii=False, key order as shown) with exactly one of two shapes.",
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "ok": {
       "const": true
      },
      "data": {}
     },
     "required": [
      "ok",
      "data"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "ok": {
       "const": false
      },
      "error": {
       "type": "object",
       "properties": {
        "code": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "ok",
      "error"
     ],
     "additionalProperties": false
    }
   ]
  },
  "error_codes": [
   "permission_denied",
   "not_found",
   "timeout",
   "connection_failed",
   "invalid_arguments",
   "nonzero_exit",
   "confirmation_required",
   "denied_by_user",
   "rate_limited",
   "unavailable",
   "error"
  ],
  "error_code_note": "Codes beginning with 'http_' followed by a status (for example http_503) and snake_case exception names (for example value_error) are also allowed."
 },
